@model OpportunityListViewModel
@inject ICurrentUserService CurrentUser
@{
    ViewData["Title"] = "Opportunities";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1">Deals & Opportunities</h4>
        <p class="text-muted small mb-0">Track commercial deals, probabilities, and closing dates</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Pipeline" class="btn btn-outline-primary d-inline-flex align-items-center gap-2">
            <i class="bi bi-kanban"></i>
            <span>Pipeline Board</span>
        </a>
        <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2">
            <i class="bi bi-plus-lg"></i>
            <span>Add Opportunity</span>
        </a>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="crm-card p-3 mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-12 col-md-4">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control border-start-0" placeholder="Search opportunity or customer..." />
            </div>
        </div>

        <div class="col-6 col-md-2">
            <select name="stage" class="form-select" asp-items="Html.GetEnumSelectList<OpportunityStage>()">
                <option value="">All Stages</option>
            </select>
        </div>

        <div class="col-6 col-md-2">
            <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<OpportunityStatus>()">
                <option value="">All Statuses</option>
            </select>
        </div>

        @if (CurrentUser.IsAdmin || CurrentUser.IsManager)
        {
            <div class="col-6 col-md-3">
                <select name="assignedTo" class="form-select" asp-items="Model.UsersList">
                    <option value="">All Deal Owners</option>
                </select>
            </div>
        }

        <div class="col-6 col-md-1 d-flex gap-2">
            <button type="submit" class="btn btn-secondary w-100">Filter</button>
        </div>
    </form>
</div>

<!-- Opportunities Table -->
<div class="crm-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Opportunity</th>
                    <th>Customer</th>
                    <th>Amount</th>
                    <th>Probability</th>
                    <th>Weighted Value</th>
                    <th>Stage</th>
                    <th>Expected Close</th>
                    <th>Status</th>
                    <th>Owner</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Opportunities.Any())
                {
                    @foreach (var o in Model.Opportunities)
                    {
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@o.OpportunityId" class="fw-semibold text-primary text-decoration-none">
                                    @o.OpportunityName
                                </a>
                            </td>
                            <td>
                                <a asp-controller="Customers" asp-action="Details" asp-route-id="@o.CustomerId" class="text-dark text-decoration-none">
                                    @o.Customer.CustomerName
                                </a>
                            </td>
                            <td><strong>₹@o.Amount.ToString("N0")</strong></td>
                            <td>@o.Probability%</td>
                            <td class="text-muted">₹@o.WeightedAmount.ToString("N0")</td>
                            <td><span class="badge bg-light text-dark border">@o.Stage</span></td>
                            <td class="small">@o.ExpectedCloseDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                <span class="badge badge-subtle @(o.Status == OpportunityStatus.Won ? "bg-success bg-opacity-10 text-success" : o.Status == OpportunityStatus.Lost ? "bg-danger bg-opacity-10 text-danger" : "bg-primary bg-opacity-10 text-primary")">
                                    @o.Status
                                </span>
                            </td>
                            <td>@(o.AssignedUser?.FullName ?? "Unassigned")</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@o.OpportunityId" class="btn btn-outline-secondary" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@o.OpportunityId" class="btn btn-outline-secondary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10" class="text-center py-4 text-muted">
                            <i class="bi bi-briefcase fs-3 d-block mb-2"></i>
                            No opportunities found matching your criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="p-3 border-top d-flex justify-content-between align-items-center">
        <span class="text-muted small">Showing @Model.Opportunities.Count of @Model.TotalCount opportunities</span>
        <partial name="_PaginationPartial" model="(Model.Page, Model.TotalPages, nameof(OpportunitiesController.Index))" />
    </div>
</div>
