@model OpportunityCreateEditViewModel
@inject ICurrentUserService CurrentUser
@{
    ViewData["Title"] = "Edit Opportunity";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="crm-card p-4 p-md-5">
            <div class="mb-4 border-bottom pb-3">
                <h4 class="fw-bold mb-1">Edit Opportunity</h4>
                <p class="text-muted small mb-0">Update deal status, commercial values, and close dates</p>
            </div>

            <form asp-action="Edit" asp-route-id="@Model.OpportunityId" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
                <input type="hidden" asp-for="OpportunityId" />

                <div class="mb-3">
                    <label asp-for="OpportunityName" class="form-label small fw-semibold">Opportunity Name <span class="text-danger">*</span></label>
                    <input asp-for="OpportunityName" class="form-control" />
                    <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="CustomerId" class="form-label small fw-semibold">Customer Account <span class="text-danger">*</span></label>
                        <select asp-for="CustomerId" class="form-select" asp-items="Model.CustomersList"></select>
                        <span asp-validation-for="CustomerId" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="LeadId" class="form-label small fw-semibold">Originating Lead (Optional)</label>
                        <select asp-for="LeadId" class="form-select" asp-items="Model.LeadsList">
                            <option value="">-- None --</option>
                        </select>
                        <span asp-validation-for="LeadId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-4">
                        <label asp-for="Amount" class="form-label small fw-semibold">Amount (₹) <span class="text-danger">*</span></label>
                        <input asp-for="Amount" class="form-control" type="number" step="0.01" min="1" />
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-4">
                        <label asp-for="Stage" class="form-label small fw-semibold">Sales Stage</label>
                        <select asp-for="Stage" class="form-select" asp-items="Html.GetEnumSelectList<OpportunityStage>()" id="stageSelect"></select>
                    </div>

                    <div class="col-12 col-md-4">
                        <label asp-for="Probability" class="form-label small fw-semibold">Win Probability (%) <span class="text-danger">*</span></label>
                        <input asp-for="Probability" class="form-control" type="number" min="0" max="100" id="probInput" />
                        <span asp-validation-for="Probability" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="ExpectedCloseDate" class="form-label small fw-semibold">Expected Close Date <span class="text-danger">*</span></label>
                        <input asp-for="ExpectedCloseDate" class="form-control" type="date" />
                        <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Source" class="form-label small fw-semibold">Deal Source</label>
                        <input asp-for="Source" class="form-control" />
                        <span asp-validation-for="Source" class="text-danger small"></span>
                    </div>
                </div>

                @if (CurrentUser.IsAdmin || CurrentUser.IsManager)
                {
                    <div class="mb-3">
                        <label asp-for="AssignedTo" class="form-label small fw-semibold">Assign Deal Owner</label>
                        <select asp-for="AssignedTo" class="form-select" asp-items="Model.UsersList"></select>
                    </div>
                }
                else
                {
                    <input type="hidden" asp-for="AssignedTo" />
                }

                <div class="mb-4">
                    <label asp-for="Notes" class="form-label small fw-semibold">Deal Notes & Scope</label>
                    <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Notes" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Details" asp-route-id="@Model.OpportunityId" class="btn btn-light">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $('#stageSelect').on('change', function () {
            var val = $(this).val();
            if (val == "1") $('#probInput').val(10);
            else if (val == "2") $('#probInput').val(40);
            else if (val == "3") $('#probInput').val(75);
            else if (val == "4") $('#probInput').val(100);
            else if (val == "5") $('#probInput').val(0);
        });
    </script>
}
