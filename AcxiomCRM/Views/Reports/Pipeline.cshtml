@model PipelineReportViewModel
@{
    ViewData["Title"] = "Pipeline Report";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1">Pipeline & Forecast Report</h4>
        <p class="text-muted small mb-0">Stage distribution, sales representative quotas, and weighted projections</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportPipelineCsv" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <i class="bi bi-download"></i>
            <span>Export CSV</span>
        </a>
        <a asp-action="Index" class="btn btn-light">Reports Hub</a>
    </div>
</div>

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-6">
        <div class="crm-card p-4">
            <span class="text-muted small fw-semibold d-block mb-1">Total Pipeline Value</span>
            <h3 class="fw-bold text-primary mb-0">₹@Model.GrandTotal.ToString("N0")</h3>
        </div>
    </div>
    <div class="col-12 col-md-6">
        <div class="crm-card p-4">
            <span class="text-muted small fw-semibold d-block mb-1">Weighted Pipeline Forecast</span>
            <h3 class="fw-bold text-success mb-0">₹@Model.GrandWeightedTotal.ToString("N0")</h3>
        </div>
    </div>
</div>

<!-- Stage Breakdown Table -->
<div class="crm-card p-4 mb-4">
    <h5 class="fw-bold mb-3">Stage-Wise Pipeline Breakdown</h5>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Stage</th>
                    <th>Number of Deals</th>
                    <th>Total Face Value</th>
                    <th>Weighted Forecast Value</th>
                    <th>% of Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.StageSummaries)
                {
                    var share = Model.GrandTotal > 0 ? (s.TotalAmount / Model.GrandTotal * 100m) : 0;
                    <tr>
                        <td><span class="badge bg-light text-dark border fs-6">@s.Stage</span></td>
                        <td><strong>@s.Count</strong></td>
                        <td>₹@s.TotalAmount.ToString("N0")</td>
                        <td><strong>₹@s.WeightedAmount.ToString("N0")</strong></td>
                        <td>@share.ToString("F1")%</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Owner Breakdown Table -->
<div class="crm-card p-4">
    <h5 class="fw-bold mb-3">Sales Executive Breakdown</h5>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Account Executive</th>
                    <th>Deals Managed</th>
                    <th>Total Value</th>
                    <th>Weighted Value</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model.OwnerSummaries)
                {
                    <tr>
                        <td><strong>@o.OwnerName</strong></td>
                        <td>@o.OpportunityCount</td>
                        <td>₹@o.TotalAmount.ToString("N0")</td>
                        <td><strong>₹@o.WeightedAmount.ToString("N0")</strong></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
