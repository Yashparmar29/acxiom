@model CustomerReportViewModel
@{
    ViewData["Title"] = "Customer Report";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1">Customer Performance Report</h4>
        <p class="text-muted small mb-0">Detailed listing and analytics of corporate customer base</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportCustomersCsv" asp-route-status="@Model.Status" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <i class="bi bi-download"></i>
            <span>Export CSV</span>
        </a>
        <a asp-action="Index" class="btn btn-light">Reports Hub</a>
    </div>
</div>

<div class="crm-card p-3 mb-4">
    <form method="get" asp-action="Customers" class="row g-2 align-items-center">
        <div class="col-12 col-md-4">
            <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<CustomerStatus>()">
                <option value="">All Statuses</option>
            </select>
        </div>
        <div class="col-6 col-md-3">
            <input type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="form-control" title="From Date" />
        </div>
        <div class="col-6 col-md-3">
            <input type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="form-control" title="To Date" />
        </div>
        <div class="col-12 col-md-2">
            <button type="submit" class="btn btn-secondary w-100">Filter</button>
        </div>
    </form>
</div>

<div class="crm-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Customer Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Company</th>
                    <th>City / State</th>
                    <th>Status</th>
                    <th>Assigned To</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Customers.Any())
                {
                    @foreach (var c in Model.Customers)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border">@c.CustomerCode</span></td>
                            <td><a asp-controller="Customers" asp-action="Details" asp-route-id="@c.CustomerId" class="fw-semibold text-primary text-decoration-none">@c.CustomerName</a></td>
                            <td>@c.Email</td>
                            <td>@c.Phone</td>
                            <td>@(c.CompanyName ?? "-")</td>
                            <td>@(string.IsNullOrEmpty(c.City) ? "-" : $"{c.City}, {c.State}")</td>
                            <td><span class="badge badge-subtle @(c.Status == CustomerStatus.Active ? "bg-success bg-opacity-10 text-success" : "bg-secondary bg-opacity-10 text-secondary")">@c.Status</span></td>
                            <td>@(c.AssignedUser?.FullName ?? "Unassigned")</td>
                            <td class="small text-muted">@c.CreatedDate.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="9" class="text-center py-4 text-muted">No records found.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="p-3 border-top d-flex justify-content-between align-items-center">
        <span class="text-muted small">Showing @Model.Customers.Count of @Model.TotalCount customers</span>
        <partial name="_PaginationPartial" model="(Model.Page, Model.TotalPages, nameof(ReportsController.Customers))" />
    </div>
</div>
