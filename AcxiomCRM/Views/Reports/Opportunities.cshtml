@model OpportunityReportViewModel
@{
    ViewData["Title"] = "Opportunity Report";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1">Opportunities & Deals Report</h4>
        <p class="text-muted small mb-0">Analysis of commercial deals, close timelines, and win rates</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportOpportunitiesCsv" asp-route-stage="@Model.Stage" asp-route-status="@Model.Status" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <i class="bi bi-download"></i>
            <span>Export CSV</span>
        </a>
        <a asp-action="Index" class="btn btn-light">Reports Hub</a>
    </div>
</div>

<div class="crm-card p-3 mb-4">
    <form method="get" asp-action="Opportunities" class="row g-2 align-items-center">
        <div class="col-6 col-md-3">
            <select name="stage" class="form-select" asp-items="Html.GetEnumSelectList<OpportunityStage>()">
                <option value="">All Stages</option>
            </select>
        </div>
        <div class="col-6 col-md-3">
            <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<OpportunityStatus>()">
                <option value="">All Statuses</option>
            </select>
        </div>
        <div class="col-6 col-md-2">
            <input type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="form-control" title="From Date" />
        </div>
        <div class="col-6 col-md-2">
            <input type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="form-control" title="To Date" />
        </div>
        <div class="col-12 col-md-2">
            <button type="submit" class="btn btn-secondary w-100">Filter</button>
        </div>
    </form>
</div>

<div class="crm-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Opportunity</th>
                    <th>Customer</th>
                    <th>Amount</th>
                    <th>Probability</th>
                    <th>Weighted Value</th>
                    <th>Stage</th>
                    <th>Expected Close</th>
                    <th>Status</th>
                    <th>Owner</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Opportunities.Any())
                {
                    @foreach (var o in Model.Opportunities)
                    {
                        <tr>
                            <td><a asp-controller="Opportunities" asp-action="Details" asp-route-id="@o.OpportunityId" class="fw-semibold text-primary text-decoration-none">@o.OpportunityName</a></td>
                            <td>@o.Customer.CustomerName</td>
                            <td>₹@o.Amount.ToString("N0")</td>
                            <td>@o.Probability%</td>
                            <td class="text-muted">₹@o.WeightedAmount.ToString("N0")</td>
                            <td><span class="badge bg-light text-dark border">@o.Stage</span></td>
                            <td class="small">@o.ExpectedCloseDate.ToString("yyyy-MM-dd")</td>
                            <td><span class="badge badge-subtle @(o.Status == OpportunityStatus.Won ? "bg-success bg-opacity-10 text-success" : o.Status == OpportunityStatus.Lost ? "bg-danger bg-opacity-10 text-danger" : "bg-primary bg-opacity-10 text-primary")">@o.Status</span></td>
                            <td>@(o.AssignedUser?.FullName ?? "Unassigned")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="9" class="text-center py-4 text-muted">No records found.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="p-3 border-top d-flex justify-content-between align-items-center">
        <span class="text-muted small">Showing @Model.Opportunities.Count of @Model.TotalCount opportunities</span>
        <partial name="_PaginationPartial" model="(Model.Page, Model.TotalPages, nameof(ReportsController.Opportunities))" />
    </div>
</div>
