@model ConversionReportViewModel
@{
    ViewData["Title"] = "Conversion Report";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1">Lead Conversion & Win Rate Report</h4>
        <p class="text-muted small mb-0">Analysis of lead qualification efficiency and converted revenue</p>
    </div>
    <a asp-action="Index" class="btn btn-light">Reports Hub</a>
</div>

<div class="crm-card p-3 mb-4">
    <form method="get" asp-action="Conversion" class="row g-2 align-items-center">
        <div class="col-6 col-md-5">
            <input type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="form-control" title="From Date" />
        </div>
        <div class="col-6 col-md-5">
            <input type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="form-control" title="To Date" />
        </div>
        <div class="col-12 col-md-2">
            <button type="submit" class="btn btn-secondary w-100">Filter</button>
        </div>
    </form>
</div>

<!-- Conversion Metrics Row -->
<div class="row g-4 mb-4">
    <div class="col-12 col-md-4">
        <div class="crm-card p-4 text-center">
            <span class="text-muted small fw-semibold d-block mb-1">Total Pipeline Leads</span>
            <h2 class="fw-bold text-dark mb-0">@Model.Summary.TotalLeads</h2>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="crm-card p-4 text-center">
            <span class="text-muted small fw-semibold d-block mb-1">Successfully Converted Leads</span>
            <h2 class="fw-bold text-success mb-0">@Model.Summary.ConvertedLeads</h2>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="crm-card p-4 text-center">
            <span class="text-muted small fw-semibold d-block mb-1">Conversion Win Ratio</span>
            <h2 class="fw-bold text-primary mb-0">@Model.Summary.ConversionPercentage%</h2>
        </div>
    </div>
</div>

<div class="crm-card p-4">
    <h5 class="fw-bold mb-3">Converted Opportunity Revenue</h5>
    <div class="d-flex align-items-center justify-content-between p-3 bg-light rounded border">
        <div>
            <div class="fw-semibold text-dark">Revenue from Converted Leads</div>
            <div class="text-muted small">Total amount of closed-won opportunities originating from converted leads</div>
        </div>
        <h3 class="fw-bold text-success mb-0">₹@Model.Summary.TotalConvertedRevenue.ToString("N0")</h3>
    </div>
</div>
