@model LeadReportViewModel
@{
    ViewData["Title"] = "Lead Report";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1">Leads Analytics Report</h4>
        <p class="text-muted small mb-0">Analysis of prospect channels, qualification rates, and valuations</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportLeadsCsv" asp-route-status="@Model.Status" asp-route-source="@Model.Source" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <i class="bi bi-download"></i>
            <span>Export CSV</span>
        </a>
        <a asp-action="Index" class="btn btn-light">Reports Hub</a>
    </div>
</div>

<div class="crm-card p-3 mb-4">
    <form method="get" asp-action="Leads" class="row g-2 align-items-center">
        <div class="col-6 col-md-3">
            <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<LeadStatus>()">
                <option value="">All Statuses</option>
            </select>
        </div>
        <div class="col-6 col-md-3">
            <select name="source" class="form-select" asp-items="Html.GetEnumSelectList<LeadSource>()">
                <option value="">All Sources</option>
            </select>
        </div>
        <div class="col-6 col-md-2">
            <input type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="form-control" title="From Date" />
        </div>
        <div class="col-6 col-md-2">
            <input type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="form-control" title="To Date" />
        </div>
        <div class="col-12 col-md-2">
            <button type="submit" class="btn btn-secondary w-100">Filter</button>
        </div>
    </form>
</div>

<div class="crm-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Lead Name</th>
                    <th>Company</th>
                    <th>Source</th>
                    <th>Priority</th>
                    <th>Expected Value</th>
                    <th>Status</th>
                    <th>Assigned To</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Leads.Any())
                {
                    @foreach (var l in Model.Leads)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border">@l.LeadCode</span></td>
                            <td><a asp-controller="Leads" asp-action="Details" asp-route-id="@l.LeadId" class="fw-semibold text-primary text-decoration-none">@l.LeadName</a></td>
                            <td>@(l.CompanyName ?? "-")</td>
                            <td><span class="badge bg-light text-dark">@l.Source</span></td>
                            <td><span class="badge bg-secondary">@l.Priority</span></td>
                            <td><strong>₹@l.ExpectedValue.ToString("N0")</strong></td>
                            <td><span class="badge bg-info bg-opacity-10 text-info">@l.Status</span></td>
                            <td>@(l.AssignedUser?.FullName ?? "Unassigned")</td>
                            <td class="small text-muted">@l.CreatedDate.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="9" class="text-center py-4 text-muted">No records found.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="p-3 border-top d-flex justify-content-between align-items-center">
        <span class="text-muted small">Showing @Model.Leads.Count of @Model.TotalCount leads</span>
        <partial name="_PaginationPartial" model="(Model.Page, Model.TotalPages, nameof(ReportsController.Leads))" />
    </div>
</div>
