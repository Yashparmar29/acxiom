@{
    ViewData["Title"] = "System Error";
}

<div class="row justify-content-center my-5">
    <div class="col-12 col-md-8 col-lg-6 text-center">
        <div class="crm-card p-5 shadow-sm">
            <div class="d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-10 text-danger rounded-circle mb-4" style="width: 72px; height: 72px;">
                <i class="bi bi-exclamation-octagon fs-1"></i>
            </div>
            <h3 class="fw-bold text-dark mb-2">An Unexpected Error Occurred</h3>
            <p class="text-muted mb-4">The system encountered an error while processing your request. Our engineering team has been notified. No sensitive internal details are exposed.</p>
            <a href="/" class="btn btn-primary px-4 py-2">
                <i class="bi bi-house-door me-1"></i> Return to Dashboard
            </a>
        </div>
    </div>
</div>
