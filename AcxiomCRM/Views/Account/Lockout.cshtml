@{
    ViewData["Title"] = "Account Locked";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5 text-center">
        <div class="crm-card p-5 shadow-sm">
            <div class="d-inline-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning rounded-circle mb-4" style="width: 72px; height: 72px;">
                <i class="bi bi-lock-fill fs-1"></i>
            </div>
            <h2 class="fw-bold text-dark mb-2">Account Temporarily Locked</h2>
            <p class="text-muted mb-4">This account has been locked for 15 minutes due to 5 consecutive failed password attempts. This security event has been logged for audit compliance. An administrator can unlock your account if needed.</p>
            <a asp-action="Login" class="btn btn-outline-secondary px-4 py-2">
                <i class="bi bi-arrow-left me-1"></i> Return to Login
            </a>
        </div>
    </div>
</div>
