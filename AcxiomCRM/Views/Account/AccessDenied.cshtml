@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5 text-center">
        <div class="crm-card p-5 shadow-sm">
            <div class="d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-10 text-danger rounded-circle mb-4" style="width: 72px; height: 72px;">
                <i class="bi bi-shield-x fs-1"></i>
            </div>
            <h2 class="fw-bold text-danger mb-2">403 - Access Denied</h2>
            <p class="text-muted mb-4">You do not have administrative or ownership permissions to view or edit this resource. URL tampering and unauthorized access are strictly blocked and audited.</p>
            <a href="/" class="btn btn-primary px-4 py-2">
                <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
            </a>
        </div>
    </div>
</div>
