@model Lead
@{
    ViewData["Title"] = $"Lead - {Model.LeadName}";
    var allowedStatuses = (IReadOnlyList<LeadStatus>)ViewBag.AllowedStatuses;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h4 class="fw-bold mb-0">@Model.LeadName</h4>
            <span class="badge bg-light text-dark border">@Model.LeadCode</span>
            <span class="badge badge-subtle @(Model.Status == LeadStatus.Converted ? "bg-success bg-opacity-10 text-success" : Model.Status == LeadStatus.Lost ? "bg-danger bg-opacity-10 text-danger" : Model.Status == LeadStatus.Qualified ? "bg-primary bg-opacity-10 text-primary" : "bg-secondary bg-opacity-10 text-secondary")">
                @Model.Status
            </span>
        </div>
        <p class="text-muted small mb-0">@(Model.CompanyName ?? "Individual") &bull; Owner: <strong>@(Model.AssignedUser?.FullName ?? "Unassigned")</strong></p>
    </div>

    <div class="d-flex gap-2">
        @if (Model.Status != LeadStatus.Converted && Model.Status != LeadStatus.Lost)
        {
            <a asp-action="Edit" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary">
                <i class="bi bi-pencil me-1"></i> Edit
            </a>
            <a asp-action="ChangeStatus" asp-route-id="@Model.LeadId" class="btn btn-outline-primary">
                <i class="bi bi-arrow-repeat me-1"></i> Change Status
            </a>
        }
        @if (Model.Status == LeadStatus.Qualified)
        {
            <a asp-action="Convert" asp-route-id="@Model.LeadId" class="btn btn-success">
                <i class="bi bi-check2-circle me-1"></i> Convert to Customer
            </a>
        }
        <a asp-controller="FollowUps" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-outline-primary">
            <i class="bi bi-calendar-plus me-1"></i> Follow-Up
        </a>
    </div>
</div>

@if (Model.Status == LeadStatus.Converted && Model.ConvertedCustomer != null)
{
    <div class="alert alert-success d-flex align-items-center justify-content-between mb-4">
        <div>
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            This lead was converted into customer <strong>@Model.ConvertedCustomer.CustomerName</strong> on @Model.ConvertedDate?.ToString("MMM dd, yyyy").
        </div>
        <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.ConvertedCustomerId" class="btn btn-sm btn-success">View Customer</a>
    </div>
}

<!-- Metrics Summary -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-3">
        <div class="crm-card p-3">
            <span class="text-muted small fw-semibold d-block mb-1">Expected Deal Value</span>
            <div class="fw-bold fs-5 text-primary">₹@Model.ExpectedValue.ToString("N0")</div>
        </div>
    </div>
    <div class="col-12 col-md-3">
        <div class="crm-card p-3">
            <span class="text-muted small fw-semibold d-block mb-1">Lead Source</span>
            <div class="fw-semibold">@Model.Source</div>
        </div>
    </div>
    <div class="col-12 col-md-3">
        <div class="crm-card p-3">
            <span class="text-muted small fw-semibold d-block mb-1">Email</span>
            <div class="fw-semibold">@(Model.Email ?? "Not provided")</div>
        </div>
    </div>
    <div class="col-12 col-md-3">
        <div class="crm-card p-3">
            <span class="text-muted small fw-semibold d-block mb-1">Phone</span>
            <div class="fw-semibold">@(Model.Phone ?? "Not provided")</div>
        </div>
    </div>
</div>

<!-- Tabs: Follow-Ups, Activities, Notes -->
<div class="crm-card">
    <div class="card-header bg-white border-bottom p-0">
        <ul class="nav nav-tabs border-0 px-3 pt-2" id="leadTabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" id="lead-followups-tab" data-bs-toggle="tab" data-bs-target="#lead-followups" type="button" role="tab">
                    <i class="bi bi-calendar-check me-1"></i> Follow-Ups (@Model.FollowUps.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="lead-activities-tab" data-bs-toggle="tab" data-bs-target="#lead-activities" type="button" role="tab">
                    <i class="bi bi-clock-history me-1"></i> Activities (@Model.Activities.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="lead-notes-tab" data-bs-toggle="tab" data-bs-target="#lead-notes" type="button" role="tab">
                    <i class="bi bi-card-text me-1"></i> Notes & Requirements
                </button>
            </li>
        </ul>
    </div>

    <div class="tab-content p-4" id="leadTabContent">
        <div class="tab-pane fade show active" id="lead-followups" role="tabpanel">
            @if (Model.FollowUps.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Subject</th>
                                <th>Status</th>
                                <th>Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in Model.FollowUps)
                            {
                                <tr>
                                    <td>@f.FollowUpDate.ToString("yyyy-MM-dd")</td>
                                    <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                                    <td><strong>@f.Subject</strong></td>
                                    <td><span class="badge bg-secondary">@f.Status</span></td>
                                    <td class="text-muted small">@(f.Remarks ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-muted text-center py-4">No follow-ups scheduled for this lead.</div>
            }
        </div>

        <div class="tab-pane fade" id="lead-activities" role="tabpanel">
            @if (Model.Activities.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var a in Model.Activities)
                    {
                        <div class="list-group-item px-0 py-3 border-0 border-bottom">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <div>
                                    <span class="badge bg-info bg-opacity-10 text-info me-2">@a.ActivityType</span>
                                    <strong class="text-dark">@a.Subject</strong>
                                </div>
                                <span class="text-muted small">@a.ActivityDate.ToString("yyyy-MM-dd HH:mm")</span>
                            </div>
                            <p class="text-muted small mb-0">@(a.Description ?? "No description provided.")</p>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-muted text-center py-4">No activities logged yet.</div>
            }
        </div>

        <div class="tab-pane fade" id="lead-notes" role="tabpanel">
            <div class="p-3 bg-light rounded border">
                <p class="mb-0 text-secondary" style="white-space: pre-wrap;">@(string.IsNullOrWhiteSpace(Model.Notes) ? "No notes recorded for this lead." : Model.Notes)</p>
            </div>
        </div>
    </div>
</div>
