@model LeadCreateEditViewModel
@inject ICurrentUserService CurrentUser
@{
    ViewData["Title"] = "Add Lead";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="crm-card p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                <div>
                    <h4 class="fw-bold mb-1">Capture New Lead</h4>
                    <p class="text-muted small mb-0">Record incoming prospective client details</p>
                </div>
                <span class="badge bg-light text-dark border">Code: @Model.LeadCode</span>
            </div>

            <form asp-action="Create" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
                <input type="hidden" asp-for="LeadCode" />

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="LeadName" class="form-label small fw-semibold">Lead Name <span class="text-danger">*</span></label>
                        <input asp-for="LeadName" class="form-control" placeholder="e.g. Ramesh Kumar" />
                        <span asp-validation-for="LeadName" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="CompanyName" class="form-label small fw-semibold">Company Name</label>
                        <input asp-for="CompanyName" class="form-control" placeholder="e.g. Bharat Logistics Ltd" />
                        <span asp-validation-for="CompanyName" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="Email" class="form-label small fw-semibold">Email Address</label>
                        <input asp-for="Email" class="form-control" placeholder="ramesh@company.in" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Phone" class="form-label small fw-semibold">Indian Mobile</label>
                        <input asp-for="Phone" class="form-control" placeholder="9820012345" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-4">
                        <label asp-for="Source" class="form-label small fw-semibold">Lead Source</label>
                        <select asp-for="Source" class="form-select" asp-items="Html.GetEnumSelectList<LeadSource>()"></select>
                    </div>

                    <div class="col-12 col-md-4">
                        <label asp-for="Priority" class="form-label small fw-semibold">Priority</label>
                        <select asp-for="Priority" class="form-select" asp-items="Html.GetEnumSelectList<LeadPriority>()"></select>
                    </div>

                    <div class="col-12 col-md-4">
                        <label asp-for="ExpectedValue" class="form-label small fw-semibold">Expected Value (₹)</label>
                        <input asp-for="ExpectedValue" class="form-control" type="number" step="0.01" min="0" max="100000000" />
                        <span asp-validation-for="ExpectedValue" class="text-danger small"></span>
                    </div>
                </div>

                @if (CurrentUser.IsAdmin || CurrentUser.IsManager)
                {
                    <div class="mb-3">
                        <label asp-for="AssignedTo" class="form-label small fw-semibold">Assign Sales Owner</label>
                        <select asp-for="AssignedTo" class="form-select" asp-items="Model.UsersList"></select>
                    </div>
                }
                else
                {
                    <input type="hidden" asp-for="AssignedTo" />
                }

                <div class="mb-4">
                    <label asp-for="Notes" class="form-label small fw-semibold">Prospect Notes & Requirements</label>
                    <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Context from initial contact..."></textarea>
                    <span asp-validation-for="Notes" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4">Save Lead</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
