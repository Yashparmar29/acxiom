@model LeadConvertViewModel
@{
    ViewData["Title"] = "Convert Lead";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="crm-card p-4 p-md-5">
            <div class="text-center mb-4 border-bottom pb-3">
                <div class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success rounded-circle mb-3" style="width: 56px; height: 56px;">
                    <i class="bi bi-check2-circle fs-2"></i>
                </div>
                <h4 class="fw-bold mb-1">Convert Qualified Lead</h4>
                <p class="text-muted small mb-0">Convert prospect <strong>@Model.LeadName</strong> (@Model.LeadCode) into an active Customer and Opportunity</p>
            </div>

            <form asp-action="Convert" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
                <input type="hidden" asp-for="LeadId" />
                <input type="hidden" asp-for="LeadCode" />
                <input type="hidden" asp-for="LeadName" />
                <input type="hidden" asp-for="ExpectedValue" />

                <div class="bg-light p-3 rounded border mb-4">
                    <h6 class="fw-semibold mb-2">Customer Account to be Created:</h6>
                    <div class="small text-muted mb-1"><strong>Account Name:</strong> @Model.LeadName</div>
                    <div class="small text-muted mb-1"><strong>Email:</strong> @(Model.Email ?? "Will be generated")</div>
                    <div class="small text-muted mb-1"><strong>Phone:</strong> @(Model.Phone ?? "Will be generated")</div>
                    <div class="small text-muted"><strong>Company:</strong> @(Model.CompanyName ?? "Individual")</div>
                </div>

                <div class="form-check form-switch mb-3">
                    <input asp-for="CreateOpportunity" class="form-check-input" id="createOppSwitch" />
                    <label asp-for="CreateOpportunity" class="form-check-label fw-semibold">Also create an Opportunity for this deal</label>
                </div>

                <div class="mb-4" id="oppNameGroup">
                    <label asp-for="OpportunityName" class="form-label small fw-semibold">Initial Opportunity Name</label>
                    <input asp-for="OpportunityName" class="form-control" />
                    <div class="form-text small">Amount will be set to the lead's expected value of ₹@Model.ExpectedValue.ToString("N0").</div>
                    <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-light">Cancel</a>
                    <button type="submit" class="btn btn-success px-4">Complete Conversion</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $('#createOppSwitch').on('change', function () {
            if ($(this).is(':checked')) {
                $('#oppNameGroup').slideDown();
            } else {
                $('#oppNameGroup').slideUp();
            }
        });
    </script>
}
