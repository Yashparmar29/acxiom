@model ActivityListViewModel
@inject ICurrentUserService CurrentUser
@{
    ViewData["Title"] = "Activities";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1">Customer Activity Log</h4>
        <p class="text-muted small mb-0">Record of client meetings, phone calls, outbound emails, and completed tasks</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2">
            <i class="bi bi-plus-lg"></i>
            <span>Log Activity</span>
        </a>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="crm-card p-3 mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-12 col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control border-start-0" placeholder="Search subject or description..." />
            </div>
        </div>

        <div class="col-6 col-md-3">
            <select name="type" class="form-select" asp-items="Html.GetEnumSelectList<ActivityType>()">
                <option value="">All Activity Types</option>
            </select>
        </div>

        @if (CurrentUser.IsAdmin || CurrentUser.IsManager)
        {
            <div class="col-6 col-md-3">
                <select name="assignedTo" class="form-select" asp-items="Model.UsersList">
                    <option value="">All Team Members</option>
                </select>
            </div>
        }

        <div class="col-12 col-md-1 d-flex gap-2">
            <button type="submit" class="btn btn-secondary w-100">Filter</button>
        </div>
    </form>
</div>

<!-- Activities Table -->
<div class="crm-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Timestamp</th>
                    <th>Type</th>
                    <th>Subject</th>
                    <th>Associated With</th>
                    <th>Logged By</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Activities.Any())
                {
                    @foreach (var a in Model.Activities)
                    {
                        <tr>
                            <td class="small">@a.ActivityDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td><span class="badge bg-light text-dark border">@a.ActivityType</span></td>
                            <td>
                                <a asp-action="Details" asp-route-id="@a.ActivityId" class="fw-semibold text-primary text-decoration-none">
                                    @a.Subject
                                </a>
                                @if (!string.IsNullOrEmpty(a.Description))
                                {
                                    <div class="text-muted small text-truncate" style="max-width: 250px;">@a.Description</div>
                                }
                            </td>
                            <td>
                                @if (a.Customer != null)
                                {
                                    <div><i class="bi bi-building text-muted me-1"></i> @a.Customer.CustomerName</div>
                                }
                                @if (a.Lead != null)
                                {
                                    <div><i class="bi bi-person-lines-fill text-muted me-1"></i> @a.Lead.LeadName</div>
                                }
                            </td>
                            <td>@(a.AssignedUser?.FullName ?? "Unknown")</td>
                            <td><span class="badge bg-success bg-opacity-10 text-success">@a.Status</span></td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@a.ActivityId" class="btn btn-outline-secondary" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@a.ActivityId" class="btn btn-outline-secondary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-danger" title="Delete"
                                            onclick="showConfirmModal('/Activities/Delete/@a.ActivityId', 'Delete Activity', 'Are you sure you want to delete this activity log?', 'Delete', 'btn-danger')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="bi bi-clock-history fs-3 d-block mb-2"></i>
                            No activity logs found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="p-3 border-top d-flex justify-content-between align-items-center">
        <span class="text-muted small">Showing @Model.Activities.Count of @Model.TotalCount activities</span>
        <partial name="_PaginationPartial" model="(Model.Page, Model.TotalPages, nameof(ActivitiesController.Index))" />
    </div>
</div>
