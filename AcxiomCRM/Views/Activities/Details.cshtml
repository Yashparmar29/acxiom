@model Activity
@{
    ViewData["Title"] = $"Activity - {Model.Subject}";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="crm-card p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                <div>
                    <span class="badge bg-info bg-opacity-10 text-info mb-1">@Model.ActivityType</span>
                    <h4 class="fw-bold mb-0">@Model.Subject</h4>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.ActivityId" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-pencil me-1"></i> Edit
                    </a>
                    <a asp-action="Index" class="btn btn-sm btn-light">Back to List</a>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3">
                    <span class="text-muted small fw-semibold d-block">Activity Date</span>
                    <div class="fw-semibold">@Model.ActivityDate.ToString("yyyy-MM-dd HH:mm")</div>
                </div>
                <div class="col-6 col-md-3">
                    <span class="text-muted small fw-semibold d-block">Status</span>
                    <span class="badge bg-success bg-opacity-10 text-success">@Model.Status</span>
                </div>
                <div class="col-6 col-md-3">
                    <span class="text-muted small fw-semibold d-block">Logged By</span>
                    <div class="fw-semibold">@(Model.AssignedUser?.FullName ?? "Unknown")</div>
                </div>
                <div class="col-6 col-md-3">
                    <span class="text-muted small fw-semibold d-block">Association</span>
                    <div class="fw-semibold">
                        @if (Model.Customer != null)
                        {
                            <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId">@Model.Customer.CustomerName</a>
                        }
                        else if (Model.Lead != null)
                        {
                            <a asp-controller="Leads" asp-action="Details" asp-route-id="@Model.LeadId">@Model.Lead.LeadName</a>
                        }
                        else
                        {
                            <span class="text-muted">None</span>
                        }
                    </div>
                </div>
            </div>

            <div class="mb-4">
                <h6 class="fw-bold mb-2">Description / Minutes</h6>
                <div class="p-3 bg-light rounded border">
                    <p class="mb-0 text-secondary" style="white-space: pre-wrap;">@(string.IsNullOrWhiteSpace(Model.Description) ? "No detailed description provided." : Model.Description)</p>
                </div>
            </div>
        </div>
    </div>
</div>
