@model AuditLog
@{
    ViewData["Title"] = $"Audit Log #{Model.AuditLogId}";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-9">
        <div class="crm-card p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                <div>
                    <span class="badge bg-light text-dark border mb-1">Module: @Model.Module</span>
                    <h4 class="fw-bold mb-0">Audit Entry #@Model.AuditLogId: @Model.Action</h4>
                </div>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Audit Log
                </a>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3">
                    <span class="text-muted small fw-semibold d-block">Performed By</span>
                    <div class="fw-semibold">@Model.UserName</div>
                    <div class="text-muted small">ID: @(Model.UserId ?? "N/A")</div>
                </div>
                <div class="col-6 col-md-3">
                    <span class="text-muted small fw-semibold d-block">Timestamp (UTC)</span>
                    <div class="fw-semibold">@Model.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</div>
                </div>
                <div class="col-6 col-md-3">
                    <span class="text-muted small fw-semibold d-block">Result & IP</span>
                    <span class="badge @(Model.Result == "Success" ? "bg-success" : "bg-danger")">@Model.Result</span>
                    <div class="text-muted small">@Model.IpAddress</div>
                </div>
                <div class="col-6 col-md-3">
                    <span class="text-muted small fw-semibold d-block">Record ID</span>
                    <div class="fw-semibold">@(Model.RecordId ?? "N/A")</div>
                </div>
            </div>

            <div class="mb-4">
                <h6 class="fw-bold mb-2">Details</h6>
                <div class="p-3 bg-light rounded border text-muted">@(Model.Details ?? "None")</div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-12 col-md-6">
                    <h6 class="fw-bold mb-2 text-danger"><i class="bi bi-dash-circle me-1"></i> Old Values (Pre-state)</h6>
                    <pre class="bg-light p-3 rounded border text-dark small" style="max-height: 250px; overflow: auto;">@(string.IsNullOrWhiteSpace(Model.OldValue) ? "None (Entity Created or Non-Mutating)" : Model.OldValue)</pre>
                </div>
                <div class="col-12 col-md-6">
                    <h6 class="fw-bold mb-2 text-success"><i class="bi bi-plus-circle me-1"></i> New Values (Post-state)</h6>
                    <pre class="bg-light p-3 rounded border text-dark small" style="max-height: 250px; overflow: auto;">@(string.IsNullOrWhiteSpace(Model.NewValue) ? "None (Entity Deleted)" : Model.NewValue)</pre>
                </div>
            </div>

            <div class="alert alert-info small mb-0">
                <i class="bi bi-info-circle me-1"></i> <strong>Append-Only Integrity:</strong> Audit log records are cryptographically protected and cannot be edited, deleted, or purged through the interface or API.
            </div>
        </div>
    </div>
</div>
