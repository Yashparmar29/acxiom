@model CustomerListViewModel
@inject ICurrentUserService CurrentUser
@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1">Customer Accounts</h4>
        <p class="text-muted small mb-0">Manage corporate customer records, contacts, and account owners</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2">
            <i class="bi bi-plus-lg"></i>
            <span>Add Customer</span>
        </a>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="crm-card p-3 mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-12 col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control border-start-0" placeholder="Search by name, code, email, phone, company..." />
            </div>
        </div>

        <div class="col-6 col-md-3">
            <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<CustomerStatus>()">
                <option value="">All Statuses</option>
            </select>
        </div>

        @if (CurrentUser.IsAdmin || CurrentUser.IsManager)
        {
            <div class="col-6 col-md-3">
                <select name="assignedTo" class="form-select" asp-items="Model.UsersList">
                    <option value="">All Account Owners</option>
                </select>
            </div>
        }

        <div class="col-12 col-md-1 d-flex gap-2">
            <button type="submit" class="btn btn-secondary w-100">Filter</button>
        </div>
    </form>
</div>

<!-- Customers Table -->
<div class="crm-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Customer Name</th>
                    <th>Contact Info</th>
                    <th>Company</th>
                    <th>Status</th>
                    <th>Assigned To</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Customers.Any())
                {
                    @foreach (var c in Model.Customers)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border">@c.CustomerCode</span></td>
                            <td>
                                <a asp-action="Details" asp-route-id="@c.CustomerId" class="fw-semibold text-primary text-decoration-none">
                                    @c.CustomerName
                                </a>
                            </td>
                            <td>
                                <div><i class="bi bi-envelope text-muted me-1"></i> @c.Email</div>
                                <div class="text-muted small"><i class="bi bi-telephone text-muted me-1"></i> @c.Phone</div>
                            </td>
                            <td>@(c.CompanyName ?? "-")</td>
                            <td>
                                <span class="badge badge-subtle @(c.Status == CustomerStatus.Active ? "bg-success bg-opacity-10 text-success" : "bg-secondary bg-opacity-10 text-secondary")">
                                    @c.Status
                                </span>
                            </td>
                            <td>@(c.AssignedUser?.FullName ?? "Unassigned")</td>
                            <td class="text-muted small">@c.CreatedDate.ToString("yyyy-MM-dd")</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@c.CustomerId" class="btn btn-outline-secondary" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@c.CustomerId" class="btn btn-outline-secondary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (c.Status == CustomerStatus.Active)
                                    {
                                        <button type="button" class="btn btn-outline-danger" title="Deactivate"
                                                onclick="showConfirmModal('/Customers/Delete/@c.CustomerId', 'Deactivate Customer', 'Are you sure you want to deactivate customer @c.CustomerName? This soft-deletes the record while preserving relational history.', 'Deactivate', 'btn-danger')">
                                            <i class="bi bi-person-x"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                            No customers found matching the search criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="p-3 border-top d-flex justify-content-between align-items-center">
        <span class="text-muted small">Showing @Model.Customers.Count of @Model.TotalCount customers</span>
        <partial name="_PaginationPartial" model="(Model.Page, Model.TotalPages, nameof(CustomersController.Index))" />
    </div>
</div>
