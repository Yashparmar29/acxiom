@inject ICurrentUserService CurrentUser
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AcxiomCRM Enterprise</title>
    <!-- Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <style>
        :root {
            --crm-primary: #4f46e5;
            --crm-primary-dark: #4338ca;
            --crm-sidebar-bg: #0f172a;
            --crm-sidebar-hover: #1e293b;
            --crm-sidebar-active: #312e81;
            --crm-body-bg: #f8fafc;
            --crm-card-border: #e2e8f0;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--crm-body-bg);
            color: #1e293b;
            min-height: 100vh;
        }

        .crm-sidebar {
            width: 260px;
            background-color: var(--crm-sidebar-bg);
            min-height: 100vh;
            color: #94a3b8;
            transition: all 0.3s ease;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 1000;
            overflow-y: auto;
        }

        .crm-sidebar .nav-link {
            color: #94a3b8;
            padding: 0.75rem 1.25rem;
            font-size: 0.9rem;
            font-weight: 500;
            border-radius: 0.5rem;
            margin: 0.2rem 0.75rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            transition: all 0.2s ease;
        }

        .crm-sidebar .nav-link:hover {
            color: #f8fafc;
            background-color: var(--crm-sidebar-hover);
        }

        .crm-sidebar .nav-link.active {
            color: #ffffff;
            background-color: var(--crm-primary);
        }

        .crm-sidebar .nav-header {
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #64748b;
            padding: 1rem 1.25rem 0.25rem;
        }

        .crm-brand {
            padding: 1.25rem 1.5rem;
            font-size: 1.25rem;
            font-weight: 700;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            border-bottom: 1px solid #1e293b;
            text-decoration: none;
        }

        .crm-main-content {
            margin-left: 260px;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .crm-topbar {
            height: 64px;
            background: #ffffff;
            border-bottom: 1px solid var(--crm-card-border);
            padding: 0 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 999;
        }

        .crm-card {
            background: #ffffff;
            border: 1px solid var(--crm-card-border);
            border-radius: 0.75rem;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .card-stat {
            padding: 1.25rem;
        }

        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 0.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
        }

        .table th {
            font-weight: 600;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #64748b;
            background-color: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
        }

        .table td {
            vertical-align: middle;
            font-size: 0.9rem;
        }

        .badge-subtle {
            font-weight: 500;
            padding: 0.35rem 0.65rem;
            border-radius: 0.375rem;
        }

        .btn-primary {
            background-color: var(--crm-primary);
            border-color: var(--crm-primary);
        }

        .btn-primary:hover {
            background-color: var(--crm-primary-dark);
            border-color: var(--crm-primary-dark);
        }

        @@media (max-width: 991.98px) {
            .crm-sidebar {
                margin-left: -260px;
            }
            .crm-sidebar.show {
                margin-left: 0;
            }
            .crm-main-content {
                margin-left: 0;
            }
        }
    </style>
</head>
<body>
    @if (CurrentUser.IsAuthenticated)
    {
        <!-- Sidebar Navigation -->
        <aside class="crm-sidebar" id="sidebarMenu">
            <a href="/" class="crm-brand">
                <i class="bi bi-shield-check text-primary"></i>
                <span>Acxiom<span class="text-primary">CRM</span></span>
            </a>

            <div class="py-2">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-grid-1x2"></i>
                    <span>Dashboard</span>
                </a>

                <div class="nav-header">CRM Modules</div>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customers" ? "active" : "")" asp-controller="Customers" asp-action="Index">
                    <i class="bi bi-building"></i>
                    <span>Customers</span>
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Leads" ? "active" : "")" asp-controller="Leads" asp-action="Index">
                    <i class="bi bi-person-lines-fill"></i>
                    <span>Leads</span>
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Opportunities" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Opportunities" asp-action="Index">
                    <i class="bi bi-briefcase"></i>
                    <span>Opportunities</span>
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Opportunities" && ViewContext.RouteData.Values["action"]?.ToString() == "Pipeline" ? "active" : "")" asp-controller="Opportunities" asp-action="Pipeline">
                    <i class="bi bi-kanban"></i>
                    <span>Pipeline Board</span>
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "FollowUps" ? "active" : "")" asp-controller="FollowUps" asp-action="Index">
                    <i class="bi bi-calendar-check"></i>
                    <span>Follow-Ups</span>
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Activities" ? "active" : "")" asp-controller="Activities" asp-action="Index">
                    <i class="bi bi-clock-history"></i>
                    <span>Activities</span>
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")" asp-controller="Reports" asp-action="Index">
                    <i class="bi bi-file-earmark-bar-graph"></i>
                    <span>Reports</span>
                </a>

                @if (CurrentUser.IsAdmin || CurrentUser.IsManager)
                {
                    <div class="nav-header">Administration</div>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")" asp-controller="Users" asp-action="Index">
                        <i class="bi bi-people"></i>
                        <span>Users</span>
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Audit" ? "active" : "")" asp-controller="Audit" asp-action="Index">
                        <i class="bi bi-journal-text"></i>
                        <span>Audit Log</span>
                    </a>
                }

                @if (CurrentUser.IsAdmin)
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Roles" ? "active" : "")" asp-controller="Roles" asp-action="Index">
                        <i class="bi bi-shield-lock"></i>
                        <span>Permissions</span>
                    </a>
                }

                <div class="nav-header">Developers</div>
                <a class="nav-link" href="/api/docs" target="_blank">
                    <i class="bi bi-code-slash"></i>
                    <span>Swagger API Docs</span>
                </a>
            </div>
        </aside>

        <!-- Main Wrapper -->
        <div class="crm-main-content">
            <!-- Topbar -->
            <header class="crm-topbar">
                <button class="btn btn-sm btn-light d-lg-none" type="button" id="sidebarToggle">
                    <i class="bi bi-list fs-5"></i>
                </button>

                <div class="d-none d-md-flex align-items-center gap-2">
                    <span class="badge bg-light text-dark border">
                        <i class="bi bi-shield-shaded text-primary me-1"></i> Role: <strong>@CurrentUser.PrimaryRole</strong>
                    </span>
                    <span class="text-muted small">| Welcome back, @CurrentUser.UserName</span>
                </div>

                <!-- User Dropdown & Logout -->
                <div class="d-flex align-items-center gap-3">
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary btn-sm dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle fs-6"></i>
                            <span class="d-none d-sm-inline">@CurrentUser.UserName</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                            <li class="dropdown-header">Signed in as <strong>@CurrentUser.PrimaryRole</strong></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="dropdown-item text-danger d-flex align-items-center gap-2">
                                        <i class="bi bi-box-arrow-right"></i> Sign Out
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Page Body Content -->
            <main class="container-fluid p-4 flex-grow-1">
                <!-- Alerts / Toasts from TempData -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
                        <i class="bi bi-check-circle-fill fs-5"></i>
                        <div>@TempData["SuccessMessage"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                        <div>@TempData["ErrorMessage"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["WarningMessage"] != null)
                {
                    <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
                        <i class="bi bi-exclamation-circle-fill fs-5"></i>
                        <div>@TempData["WarningMessage"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="bg-white border-top py-3 px-4 text-center text-muted small">
                &copy; @DateTime.UtcNow.Year AcxiomCRM Enterprise System. All rights reserved.
            </footer>
        </div>
    }
    else
    {
        <!-- Public Layout for Login / Register -->
        <main class="min-vh-100 d-flex flex-column justify-content-center py-5">
            <div class="container">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @RenderBody()
            </div>
        </main>
    }

    <!-- Generic Confirmation Modal for Destructive Actions -->
    <div class="modal fade" id="confirmActionModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="confirmModalTitle">Confirm Action</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="confirmModalMessage">
                    Are you sure you want to proceed with this action?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <form id="confirmActionForm" method="post" action="">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger" id="confirmModalSubmitBtn">Confirm</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>

    <script>
        // Sidebar Toggle for Mobile
        $('#sidebarToggle').on('click', function () {
            $('#sidebarMenu').toggleClass('show');
        });

        // Reusable Confirmation Modal Helper
        function showConfirmModal(actionUrl, title, message, btnText, btnClass) {
            $('#confirmActionForm').attr('action', actionUrl);
            if (title) $('#confirmModalTitle').text(title);
            if (message) $('#confirmModalMessage').text(message);
            if (btnText) $('#confirmModalSubmitBtn').text(btnText);
            if (btnClass) $('#confirmModalSubmitBtn').attr('class', 'btn ' + btnClass);
            var modal = new bootstrap.Modal(document.getElementById('confirmActionModal'));
            modal.show();
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
