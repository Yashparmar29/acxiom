@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-7 col-lg-5">
        <div class="crm-card p-4 p-md-5">
            <div class="mb-4 border-bottom pb-3">
                <h4 class="fw-bold mb-1">Reset User Password</h4>
                <p class="text-muted small mb-0">Set a new compliant password for <strong>@Model.Email</strong></p>
            </div>

            <form asp-action="ResetPassword" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Email" />

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label small fw-semibold">New Password <span class="text-danger">*</span></label>
                    <input asp-for="NewPassword" class="form-control" placeholder="Min 8 chars, 1 uppercase, 1 digit, 1 special" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label small fw-semibold">Confirm New Password <span class="text-danger">*</span></label>
                    <input asp-for="ConfirmPassword" class="form-control" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light">Cancel</a>
                    <button type="submit" class="btn btn-warning px-4">Reset Password</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
