@model UserListViewModel
@inject ICurrentUserService CurrentUser
@{
    ViewData["Title"] = "User Management";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1">User Administration</h4>
        <p class="text-muted small mb-0">Manage system accounts, role assignments, security status, and account locks</p>
    </div>
    @if (CurrentUser.IsAdmin)
    {
        <div>
            <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2">
                <i class="bi bi-person-plus"></i>
                <span>Add User</span>
            </a>
        </div>
    }
</div>

<div class="crm-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Lockout Status</th>
                    <th>Created</th>
                    @if (CurrentUser.IsAdmin)
                    {
                        <th class="text-end">Admin Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Users)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@u.FullName</div>
                            @if (!string.IsNullOrEmpty(u.PhoneNumber))
                            {
                                <div class="text-muted small"><i class="bi bi-telephone text-muted me-1"></i> @u.PhoneNumber</div>
                            }
                        </td>
                        <td>@u.Email</td>
                        <td>
                            <span class="badge @(u.Role == CrmRoles.Admin ? "bg-dark" : u.Role == CrmRoles.Manager ? "bg-primary" : "bg-info")">
                                @u.Role
                            </span>
                        </td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger">Inactive</span>
                            }
                        </td>
                        <td>
                            @if (u.IsLockedOut)
                            {
                                <span class="badge bg-danger">
                                    <i class="bi bi-lock-fill me-1"></i> Locked Out
                                </span>
                                @if (u.LockoutEnd.HasValue)
                                {
                                    <div class="text-danger small">Until @u.LockoutEnd.Value.ToString("HH:mm:ss")</div>
                                }
                            }
                            else
                            {
                                <span class="text-muted small">Normal (Attempts: @u.AccessFailedCount)</span>
                            }
                        </td>
                        <td class="small text-muted">@u.CreatedDate.ToString("yyyy-MM-dd")</td>
                        @if (CurrentUser.IsAdmin)
                        {
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-outline-secondary" title="Edit User">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="ResetPassword" asp-route-id="@u.Id" class="btn btn-outline-secondary" title="Reset Password">
                                        <i class="bi bi-key"></i>
                                    </a>

                                    @if (u.IsLockedOut)
                                    {
                                        <button type="button" class="btn btn-outline-warning" title="Unlock User"
                                                onclick="showConfirmModal('/Users/Unlock/@u.Id', 'Unlock User Account', 'Are you sure you want to unlock user @u.Email? Failed attempt counter will be reset.', 'Unlock Account', 'btn-warning')">
                                            <i class="bi bi-unlock"></i>
                                        </button>
                                    }

                                    @if (u.IsActive)
                                    {
                                        <button type="button" class="btn btn-outline-danger" title="Deactivate User"
                                                onclick="showConfirmModal('/Users/ToggleActive/@u.Id?isActive=false', 'Deactivate User', 'Are you sure you want to deactivate @u.Email? They will be unable to log in.', 'Deactivate', 'btn-danger')">
                                            <i class="bi bi-person-slash"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-outline-success" title="Activate User"
                                                onclick="showConfirmModal('/Users/ToggleActive/@u.Id?isActive=true', 'Activate User', 'Reactivate access for @u.Email?', 'Activate', 'btn-success')">
                                            <i class="bi bi-person-check"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
